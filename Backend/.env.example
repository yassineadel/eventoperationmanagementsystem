# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL. Each developer uses their own database (Docker, Supabase or Neon), never a shared one.
# For hosted databases add &connection_limit=15 so an on-sale rush queues instead of failing to connect.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Redis: pending registrations, verification codes, token blacklist
REDIS_URL="redis://localhost:6379"

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email sender for verification and reset codes
MAIL_USER=you@example.com
MAIL_PASS=

# Google sign-in (Google Cloud console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Stripe test mode (dashboard.stripe.com → Developers → API keys). Use sk_test_ keys only.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
