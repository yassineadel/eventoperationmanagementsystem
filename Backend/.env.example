# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL. Each developer uses their own database (Docker, Supabase or Neon), never a shared one.
# Two URLs:
# - DATABASE_URL: what the running app uses.
# - DIRECT_URL:   what `npx prisma migrate ...` uses. Migrations need their own, unshared connection.
#
# Plain or local database (Docker, local PostgreSQL, Neon's direct URL): use the same URL for both.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
#
# Supabase (Dashboard -> Connect): use the Transaction pooler (port 6543) for the app, because the
# Session pooler (5432) refuses new clients when too many connect at once (EMAXCONNSESSION).
# pgbouncer=true tells Prisma not to use prepared statements, which the transaction pooler does not support.
# connection_limit is how many connections Prisma opens; extra requests wait in a queue. 15 matches the
# free plan's pool size (see Database -> Settings -> Connection pooling); raise it on a bigger plan.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&sslmode=require"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Redis: pending registrations, verification codes, token blacklist
REDIS_URL="redis://localhost:6379"

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email sender for verification and reset codes
MAIL_USER=you@example.com
MAIL_PASS=

# Optional SMTP relay. Leave MAIL_HOST unset to keep Gmail delivery above.
# Local test inbox (MailDev): MAIL_HOST=127.0.0.1, MAIL_PORT=1025,
# MAIL_SECURE=false, MAIL_AUTH=false. Messages stay in the local inbox.
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_SECURE=false
# MAIL_AUTH=false

# Google sign-in (Google Cloud console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Payments: "simulator" (default, no account needed) or "stripe"
PAYMENT_PROVIDER=simulator

# Stripe test mode (dashboard.stripe.com → Developers → API keys). Use sk_test_ keys only.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Chatbot (Google Gemini). Optional: leave the key empty if you don't work on the assistant.
# Free key: https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# used in order when the chat model is busy (free-tier 503 / 429)
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
