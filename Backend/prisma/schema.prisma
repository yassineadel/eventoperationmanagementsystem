generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_profiles {
  id                                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                String  @unique @db.Uuid
  tier                                   String? @default("standard") @db.VarChar(30)
  invited_by                             String? @db.Uuid
  notes                                  String?
  users_guest_profiles_invited_byTousers User?   @relation("guest_profiles_invited_byTousers", fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_guest_profiles_user_idTousers    User    @relation("guest_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invitations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  invited_by String   @db.Uuid
  email      String   @db.VarChar(255)
  role       String   @default("guest") @db.VarChar(30)
  token      String   @unique @db.VarChar(512)
  status     String   @default("pending") @db.VarChar(20)
  expires_at DateTime @db.Timestamptz(6)
  events     Event    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      User     @relation(fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String    @db.Uuid
  order_id String?   @db.Uuid
  channel  String    @db.VarChar(20)
  subject  String?   @db.VarChar(300)
  status   String    @default("pending") @db.VarChar(20)
  sent_at  DateTime? @db.Timestamptz(6)
  orders   orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users    User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String         @db.Uuid
  ticket_category_id String         @db.Uuid
  quantity           Int
  unit_price         Decimal        @db.Decimal(10, 2)
  orders             orders         @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_categories  TicketCategory @relation(fields: [ticket_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets            tickets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String          @db.Uuid
  status        String          @default("pending") @db.VarChar(20)
  total_amount  Decimal         @db.Decimal(10, 2)
  expires_at    DateTime?       @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  notifications notifications[]
  order_items   order_items[]
  users         User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments      payments?

  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String    @unique(map: "uidx_payments_order_success") @db.Uuid
  provider       String    @db.VarChar(50)
  provider_tx_id String    @unique @db.VarChar(255)
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD") @db.Char(3)
  status         String    @db.VarChar(20)
  paid_at        DateTime? @db.Timestamptz(6)
  orders         orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff_profiles {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @unique @db.Uuid
  event_id     String    @db.Uuid
  position     String?   @db.VarChar(100)
  access_level String    @default("scanner") @db.VarChar(30)
  shift_start  DateTime? @db.Timestamptz(6)
  shift_end    DateTime? @db.Timestamptz(6)
  assigned_at  DateTime  @default(now()) @db.Timestamptz(6)
  events       Event     @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tickets {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_item_id String      @db.Uuid
  user_id       String      @db.Uuid
  ticket_code   String      @unique @db.VarChar(50)
  qr_hash       String      @unique @db.VarChar(512)
  status        String      @default("issued") @db.VarChar(20)
  issued_at     DateTime    @default(now()) @db.Timestamptz(6)
  scanned_at    DateTime?   @db.Timestamptz(6)
  order_items   order_items @relation(fields: [order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         User        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_tickets_status")
  @@index([user_id], map: "idx_tickets_user")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(200)
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  googleId     String?  @unique @map("google_id") @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  role         UserRole @default(USER)

  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedReason String?   @map("blocked_reason")
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockedById   String?   @map("blocked_by_id") @db.Uuid
  blockedBy     User?     @relation("UserBlocks", fields: [blockedById], references: [id])
  blockedUsers  User[]    @relation("UserBlocks")

  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  isSynthetic    Boolean @default(false) @map("is_synthetic")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // relations to models not yet rebuilt (groups 2-4)
  createdEvents                                   Event[]
  guest_profiles_guest_profiles_invited_byTousers guest_profiles[] @relation("guest_profiles_invited_byTousers")
  guest_profiles_guest_profiles_user_idTousers    guest_profiles?  @relation("guest_profiles_user_idTousers")
  invitations                                     invitations[]
  notifications                                   notifications[]
  orders                                          orders[]
  staff_profiles                                  staff_profiles?
  tickets                                         tickets[]

  @@map("users")
}

// ─── Catalogue ──────────────────────────────────────────────────────────────
// Venue layouts are authored as JSON in src/modules/venues/layouts and seeded into
// venues + seats/venue_zones. Seats and zones carry a categoryKey (e.g. "VIP") and are
// matched to an event's TicketCategory by (venue, categoryKey) — a venue is reused by
// many events, each pricing its own categories.

enum VenueType {
  SEATED
  STANDING
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Venue {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(100)
  name      String    @db.VarChar(200)
  type      VenueType
  address   String
  city      String    @db.VarChar(100)
  country   String    @db.VarChar(100)
  latitude  Decimal   @db.Decimal(9, 6)
  longitude Decimal   @db.Decimal(9, 6)
  capacity  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  seats  Seat[]
  zones  VenueZone[]
  events Event[]

  @@index([city])
  @@map("venues")
}

model Seat {
  id          String @id @default(uuid()) @db.Uuid
  venueId     String @map("venue_id") @db.Uuid
  section     String @db.VarChar(20)
  row         String @db.VarChar(10)
  number      Int
  categoryKey String @map("category_key") @db.VarChar(50)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, section, row, number])
  @@index([venueId, categoryKey])
  @@map("seats")
}

model VenueZone {
  id          String @id @default(uuid()) @db.Uuid
  venueId     String @map("venue_id") @db.Uuid
  key         String @db.VarChar(50)
  label       String @db.VarChar(100)
  categoryKey String @map("category_key") @db.VarChar(50)
  capacity    Int
  // rectangle in a 0–100 coordinate space, used to draw the zone (FR-TKT-20)
  x           Float
  y           Float
  width       Float
  height      Float

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, key])
  @@map("venue_zones")
}

model Event {
  id              String    @id @default(uuid()) @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  name            String    @db.VarChar(300)
  category        String    @db.VarChar(50)
  performer       String?   @db.VarChar(200)
  description     String
  about           String?
  images          String[]
  startAt         DateTime  @map("start_at") @db.Timestamptz(6)
  doorsOpenAt     DateTime  @map("doors_open_at") @db.Timestamptz(6)
  durationMinutes Int       @map("duration_minutes")
  // age restrictions, prohibited items, entry conditions, refund policy (FR-EVT-07)
  policies        Json?
  // [{ question, answer }] — also feeds the chatbot retrieval layer (FR-EVT-08)
  faqs            Json?
  salesOpenAt     DateTime? @map("sales_open_at") @db.Timestamptz(6)
  salesCloseAt    DateTime? @map("sales_close_at") @db.Timestamptz(6)

  // past events are hidden by date, never deleted (FR-LST-02/03, BR-19)
  status             EventStatus @default(DRAFT)
  publishedAt        DateTime?   @map("published_at") @db.Timestamptz(6)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?     @map("cancellation_reason")

  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue            Venue            @relation(fields: [venueId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])
  ticketCategories TicketCategory[]

  // relations to models not yet rebuilt (groups 3-4)
  invitations    invitations[]
  staff_profiles staff_profiles[]

  @@index([status, startAt])
  @@index([category])
  @@index([venueId])
  @@map("events")
}

model TicketCategory {
  id                String  @id @default(uuid()) @db.Uuid
  eventId           String  @map("event_id") @db.Uuid
  // matches Seat.categoryKey / VenueZone.categoryKey of the event's venue
  categoryKey       String  @map("category_key") @db.VarChar(50)
  name              String  @db.VarChar(100)
  description       String?
  // fixed once the event is published (FR-ADM-08, BR-15)
  price             Decimal @db.Decimal(10, 2)
  // per category, retained on user refunds (BR-05, FR-MTK-06/07)
  serviceFeePercent Decimal @map("service_fee_percent") @db.Decimal(5, 2)
  capacity          Int
  // live counter shown to buyers (FR-TKT-02/03)
  remaining         Int

  event Event @relation(fields: [eventId], references: [id])

  // relations to models not yet rebuilt (group 3)
  order_items order_items[]

  @@unique([eventId, categoryKey])
  @@map("ticket_categories")
}
